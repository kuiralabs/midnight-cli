{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    // Inside this repository the workspace packages run from their source.
    "customConditions": ["midnight-cli-source"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vitest/globals", "ws"]
  },
  "include": ["src/**/*.ts", "packages/cli-core/src/**/*.ts", "packages/chain/src/**/*.ts", "packages/engine-rc/src/**/*.ts"],
  "exclude": ["node_modules"]
}
