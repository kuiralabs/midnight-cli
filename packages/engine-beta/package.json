{
  "name": "@kuiralabs/midnight-engine-beta",
  "version": "0.1.0-rc.3",
  "type": "module",
  "description": "The Midnight CLI's engine for the SDK's beta set that stagenet runs (wallet SDK 5.0 beta split packages, ledger 9 rc.3, midnight-js 5 beta): everything the CLI does with that SDK set, behind the engine interface",
  "license": "Apache-2.0",
  "author": "nel349",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuiralabs/midnight-cli.git",
    "directory": "packages/engine-beta"
  },
  "bugs": {
    "url": "https://github.com/kuiralabs/midnight-cli/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "midnight-cli-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  },
  "dependencies": {
