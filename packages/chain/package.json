{
  "name": "@kuiralabs/midnight-chain",
  "version": "0.1.0-rc.2",
  "type": "module",
  "description": "Read-only network access for the Midnight CLI packages: node, indexer and proof-server readiness, chain id, tip, events and the ledger-version guard",
  "license": "Apache-2.0",
  "author": "nel349",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuiralabs/midnight-cli.git",
    "directory": "packages/chain"
  },
  "bugs": {
    "url": "https://github.com/kuiralabs/midnight-cli/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "midnight-cli-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commands": {
      "midnight-cli-source": "./src/commands.ts",
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kuiralabs/midnight-cli-core": "0.1.0-rc.2",
    "ws": "^8.19.0"
  }
}
