{
  "name": "@kuiralabs/midnight-wallet",
  "version": "0.1.0",
  "type": "module",
  "description": "Wallets for the Midnight CLI packages: mn's passphrase and sealed wallet files, seeds, balances, NIGHT transfers and airdrops, Dust registration, and swap offers",
  "license": "Apache-2.0",
  "author": "nel349",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuiralabs/midnight-cli.git",
    "directory": "packages/wallet"
  },
  "bugs": {
    "url": "https://github.com/kuiralabs/midnight-cli/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "midnight-cli-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commands": {
      "midnight-cli-source": "./src/commands.ts",
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kuiralabs/midnight-chain": "0.1.0",
    "@kuiralabs/midnight-cli-core": "0.1.0",
    "@scure/bip39": "^2.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
