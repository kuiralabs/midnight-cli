{
  "name": "midnight-wallet-cli",
  "version": "0.6.0-rc.13",
  "type": "module",
  "description": "Git-style CLI wallet for the Midnight blockchain",
  "license": "Apache-2.0",
  "author": "Norman Lopez (https://github.com/nel349)",
  "homepage": "https://github.com/kuiralabs/midnight-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuiralabs/midnight-cli.git"
  },
  "bugs": {
    "url": "https://github.com/kuiralabs/midnight-cli/issues"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "wallet",
    "cli",
    "zk",
    "zero-knowledge",
    "compact",
    "mcp",
    "ai-agent"
  ],
  "workspaces": [
    "packages/connector",
    "packages/cli-core",
    "packages/chain",
    "packages/engine-rc",
    "packages/engine-beta",
    "packages/wallet",
    "packages/contract",
    "packages/connect",
    "packages/dev",
    "packages/grant"
  ],
  "bin": {
    "midnight": "dist/wallet.js",
    "mn": "dist/wallet.js",
    "midnight-wallet-cli": "dist/wallet.js",
    "midnight-wallet-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "docs/SKILL.md",
    "docs/SKILL-CORE.md",
    "NOTICE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "wallet": "tsx --conditions=midnight-cli-source src/wallet.ts",
    "build": "npm run build -w @kuiralabs/midnight-cli-core && npm run build -w @kuiralabs/midnight-chain && npm run build -w @kuiralabs/midnight-engine-rc && npm run build -w @kuiralabs/midnight-engine-beta && npm run build -w @kuiralabs/midnight-wallet && npm run build -w @kuiralabs/midnight-contract && npm run build -w @kuiralabs/midnight-connect && npm run build -w @kuiralabs/midnight-dev && npm run build -w @kuiralabs/midnight-grant && node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && bun build src/wallet.ts src/mcp-server.ts --outdir dist --splitting --target node --format esm --packages external --minify --banner \"#!/usr/bin/env node\"",
    "mcp": "tsx --conditions=midnight-cli-source src/mcp-server.ts",
    "link": "bun link",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest run",
    "test:rc": "vitest run --exclude '**/src/__tests__/engine-beta*.test.ts' --exclude 'packages/engine-beta/**'",
    "test:beta": "vitest run src/__tests__/engine-beta packages/engine-beta",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "api-report": "node scripts/api-report.mjs write",
    "typecheck": "tsc --noEmit",
    "skill-docs": "tsx --conditions=midnight-cli-source scripts/write-skill-docs.ts",
    "readme-commands": "tsx --conditions=midnight-cli-source scripts/write-readme-commands.ts",
    "package-readmes": "tsx --conditions=midnight-cli-source scripts/write-package-readmes.ts"
  },
  "dependencies": {
    "@kuiralabs/midnight-chain": "0.1.0-rc.2",
    "@kuiralabs/midnight-cli-core": "0.1.0-rc.2",
    "@kuiralabs/midnight-connect": "0.1.0-rc.2",
    "@kuiralabs/midnight-contract": "0.1.0-rc.2",
    "@kuiralabs/midnight-dev": "0.1.0-rc.2",
    "@kuiralabs/midnight-engine-beta": "0.1.0-rc.2",
    "@kuiralabs/midnight-engine-rc": "0.1.0-rc.2",
    "@kuiralabs/midnight-grant": "0.1.0-rc.2",
    "@kuiralabs/midnight-wallet": "0.1.0-rc.2",
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "devDependencies": {
    "@midnightntwrk/dapp-connector-api": "4.1.0-beta.1",
    "@types/node": "^22.19.13",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@midnightntwrk/wallet-sdk-node-client@2.0.0-beta.2": "2.0.0-beta.4"
  }
}
